Table "public"."Address" {
  "id" int [pk, not null, increment]
  "CEP" varchar(8) [not null]
  "street" varchar(255) [not null]
  "number" varchar(20) [not null]
  "apt" varchar(50)
  "complementary" varchar(255)
  "city" varchar(255)
  "state" varchar(2)
}

Table "public"."coupon" {
  "id" int [pk, not null, increment]
  "restaurant_id" int [not null, ref: > "public"."restaurant"."id"]
  "code" varchar(50) [not null]
  "name" varchar(255)
  "title" varchar(255)
  "description" text
  "target_scope" varchar(8) [not null, default: 'order']
  "target_item_id" int [ref: > "public"."menu_item"."id"]
  "is_banner" boolean [not null, default: false]
  "background_image_url" text
  "discount_type" discount_type_enum [not null]
  "discount_value" bigint [not null]
  "min_order_cents" bigint [not null, default: 0]
  "max_uses" int
  "used_count" int [not null, default: 0]
  "is_active" boolean [not null, default: true]
  "expires_at" timestamptz
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]

  Indexes {
    (restaurant_id, `upper(code)`) [unique, name: "coupon_code_folded_unique"]
    (restaurant_id, code) [unique, name: "idx_coupons_restaurant_id_code"]
  }
}

Table "public"."coupon_claim" {
  "account_id" int [not null, ref: > "public"."account"."id"]
  "coupon_id" int [not null, ref: > "public"."coupon"."id"]
  "claimed_at" timestamptz [not null, default: `now()`]
  Indexes {
    (account_id, coupon_id) [pk]
  }
}

Table "public"."order_promotion" {
  "order_id" int [pk, not null, ref: > "public"."order"."id"]
  "result" jsonb [not null]
}

Table "public"."order_coupon" {
  "order_id" int [not null, ref: > "public"."order"."id"]
  "coupon_id" int [not null, ref: > "public"."coupon"."id"]
  "coupon_code" varchar(50) [not null]
  "discount_cents" bigint [not null]
  Indexes {
    (order_id, coupon_id) [pk]
  }
}

Table "public"."restaurant" {
  "id" int [pk, not null, increment]
  "name_slug" varchar(255) [unique, not null]
  "name" varchar(255) [not null]
  "description" text
  "icon_url" text
  "favicon_url" text
  "cover_url" text
  "loyalty_earn_rate" numeric(5,2) [not null, default: 1, note: 'coins per R$ 1 spent']
  "archived_at" timestamptz
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
}

Table "public"."verification_code" {
  "id" bigserial [pk, not null, increment]
  "account_id" int [ref: > "public"."account"."id"]
  "phone" varchar(20)
  "email" varchar(255)
  "code_hash" varchar(255) [not null]
  "purpose" verification_purpose_enum [not null]
  "attempts" int [not null, default: 0]
  "expires_at" timestamptz [not null]
  "consumed_at" timestamptz
  "created_at" timestamptz [not null, default: `now()`]

  Indexes {
    (email, purpose) [name: "idx_verification_code_email_purpose"]
    (phone, purpose) [name: "idx_verification_code_phone_purpose"]
  }

  Note: 'One active row per (phone|email, purpose). Purge where expires_at < now().'
}

Table "public"."refresh_token" {
  "id" bigserial [pk, not null, increment]
  "account_id" int [not null, ref: > "public"."account"."id"]
  "token_hash" varchar(255) [unique, not null]
  "expires_at" timestamptz [not null]
  "revoked_at" timestamptz
  "user_agent" varchar(255)
  "ip" varchar(45)
  "created_at" timestamptz [not null, default: `now()`]

  Indexes {
    (account_id, expires_at) [name: "idx_refresh_token_account_id_expires_at"]
  }

  Note: 'Store sha256(token). token_version on account is the kill-switch.'
}

Table "public"."menu_item" {
  "id" int [pk, not null, increment]
  "restaurant_id" int [not null, ref: > "public"."restaurant"."id"]
  "category_id" int [not null, ref: > "public"."category"."id"]
  "name" varchar(255) [not null]
  "description" text
  "base_price_cents" bigint [not null, note: 'money in BRL cents']
  "base_cost_cents" bigint [note: 'optional recipe/production cost; null or 0 if undisclosed']
  "image_url" text
  "is_available" boolean [not null, default: true]
  "is_combo" boolean [not null, default: false]
  "allows_review" boolean [not null, default: true]
  "archived_at" timestamptz
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]

  Note: 'Cost is optional. Margin / Menu Engineering queries must check base_cost_cents > 0 before computing.'
}

Table "public"."menu" {
  "id" int [pk, not null, increment]
  "restaurant_id" int [unique, not null, ref: > "public"."restaurant"."id"]
  "name" varchar(255)
  "style" menu_style_enum [not null, default: 'CLASSICO']
  "accent_color" varchar(7)
  "secondary_color" varchar(7)
  "typography" varchar(50)
  "updated_at" timestamptz [not null, default: `now()`]
}

Table "public"."order" {
  "id" int [pk, not null, increment]
  "physical_restaurant_id" int [not null, ref: > "public"."physical_restaurant"."id"]
  "account_id" int [note: 'authenticated customer or employee who placed it', ref: > "public"."account"."id"]
  "customer_cpf" varchar(11) [note: 'anonymous CPF for loyalty accrual']
  "coupon_id" int [ref: > "public"."coupon"."id"]
  "coupon_code" varchar(50) [note: 'snapshot']
  "order_type" order_type_enum [not null]
  "status" order_status_enum [not null, default: 'pending']
  "subtotal_cents" bigint [not null, default: 0]
  "discount_cents" bigint [not null, default: 0]
  "freight_cents" bigint [not null, default: 0]
  "submitted_at" timestamptz [default: `now()`, note: 'Null for an unsubmitted draft']
  "guest_token_hash" bytea
  "qr_id" bigint [ref: > "public"."order_qr"."id"]
  "menu_session_id" bigint [ref: > "public"."menu_session"."id"]
  "total_cents" bigint [not null, default: 0]
  "rating" smallint [note: '1-5; null until rated']
  "feedback" text
  "rated_at" timestamptz
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]

  Indexes {
    (account_id, created_at) [name: "idx_order_account_id_created_at"]
    (customer_cpf, created_at) [name: "idx_order_customer_cpf_created_at"]
    (physical_restaurant_id, status, created_at) [name: "idx_order_physical_restaurant_id_status_created_at"]
  }

  Note: 'account_id and customer_cpf are mutually exclusive — app-enforced XOR. Both null = anonymous walk-in. When customer_cpf is set, the app resolves to account via account.cpf (creating a shadow account if needed) to credit the wallet.'
}

Table "public"."order_item" {
  "id" int [pk, not null, increment]
  "order_id" int [not null, ref: > "public"."order"."id"]
  "item_id" int [not null, ref: > "public"."menu_item"."id"]
  "item_name" varchar(255) [not null, note: 'snapshot']
  "unit_price_cents" bigint [not null, note: 'snapshot']
  "unit_cost_cents" bigint [note: 'snapshot of menu_item.base_cost_cents at order time']
  "line_total_cents" bigint [not null]
  "quantity" int [not null, default: 1]
  "notes" text
  "selected_options" jsonb [not null, default: ` '[]'::jsonb `, note: 'snapshot of chosen side options']
  "parent_order_item_id" int [ref: > "public"."order_item"."id"]
  "voided_at" timestamptz
  "voided_reason" text
  "created_at" timestamptz [not null, default: `now()`]
}

Table "public"."category" {
  "id" int [pk, not null, increment]
  "restaurant_id" int [not null, ref: > "public"."restaurant"."id"]
  "name" varchar(100) [not null]
  "display_order" int [not null, default: 0]
  "is_fallback" boolean [not null, default: false, note: 'Unique per restaurant where true']
  "image_url" text
  "archived_at" timestamptz
  "created_at" timestamptz [not null, default: `now()`]
}

Table "public"."ingredient" {
  "id" int [pk, not null, increment]
  "restaurant_id" int [not null, ref: > "public"."restaurant"."id"]
  "name" varchar(255) [not null]
  "default_unit" ingredient_unit_enum

  Indexes {
    (restaurant_id, name) [unique, name: "idx_ingredient_restaurant_id_name"]
  }
}

Table "public"."item_sale" {
  "id" int [pk, not null, increment]
  "item_id" int [not null, ref: > "public"."menu_item"."id"]
  "branch_id" int [ref: > "public"."physical_restaurant"."id"]
  "discount_type" discount_type_enum [not null]
  "discount_value" bigint [not null]
  "starts_at" timestamptz [not null]
  "ends_at" timestamptz [not null]
  "is_active" boolean [not null, default: true]
  "created_at" timestamptz [not null, default: `now()`]

  Indexes {
    (item_id, is_active) [name: "idx_item_sale_item_id_is_active"]
  }
}

Table "public"."item_side_option" {
  "id" int [pk, not null, increment]
  "item_side_id" int [not null, ref: > "public"."item_side"."id"]
  "name" varchar(255) [not null]
  "additional_price_cents" bigint [not null, default: 0]
  "is_available" boolean [not null, default: true]
}

Table "public"."transaction" {
  "id" int [pk, not null, increment]
  "order_id" int [not null, ref: > "public"."order"."id"]
  "transaction_type" transaction_type_enum [not null]
  "card_brand" card_brand_enum
  "amount_cents" bigint [not null]
  "refunded_cents" bigint [not null, default: 0]
  "status" transaction_status_enum [not null, default: 'pending']
  "created_by_account_id" int [ref: > "public"."account"."id"]
  "notes" varchar(100)
  "idempotency_key" varchar(128)
  "request_fingerprint" text
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]

  Indexes {
    (order_id, status) [name: "idx_transaction_order_id_status"]
  }

  Note: 'Non-null idempotency_key is unique per order.'
}

Table "public"."combo_item" {
  "id" int [unique, not null, increment]
  "combo_id" int [not null, ref: > "public"."menu_item"."id"]
  "included_item_id" int [not null, ref: > "public"."menu_item"."id"]
  "quantity" int [not null, default: 1]

  Indexes {
    (combo_id, included_item_id) [pk]
  }
}

Table "public"."branch_item_availability" {
  "branch_id" int [not null, ref: > "public"."physical_restaurant"."id"]
  "item_id" int [not null, ref: > "public"."menu_item"."id"]
  "is_available" boolean [not null]

  Indexes {
    (branch_id, item_id) [pk]
  }
}

Table "public"."branch_option_availability" {
  "branch_id" int [not null, ref: > "public"."physical_restaurant"."id"]
  "option_id" int [not null]
  "is_available" boolean [not null]

  Indexes {
    (branch_id, option_id) [pk]
  }
}

Ref: "public"."branch_option_availability"."option_id" > "public"."item_side_option"."id" [delete: cascade]

Table "public"."item_side" {
  "id" int [pk, not null, increment]
  "item_id" int [not null, ref: > "public"."menu_item"."id"]
  "title" varchar(255) [not null]
  "min_options" int [not null, default: 0]
  "max_options" int [not null]
}

Table "public"."local_order" {
  "id" int [pk, not null, ref: - "public"."order"."id"]
  "table_id" int [ref: > "public"."dining_table"."id"]
  "table_number" int [note: 'snapshot; null for counter/takeout/bar']
  "display_order" int [not null, default: 0]
  "notes" text

  Note: 'table_id null = counter/takeout/bar service with no assigned table'
}

Table "public"."order_qr" {
  "id" bigserial [pk, not null, increment]
  "branch_id" int [not null, ref: > "public"."physical_restaurant"."id"]
  "table_id" int [ref: > "public"."dining_table"."id"]
  "token_hash" bytea [not null, unique]
  "created_at" timestamptz [not null, default: `now()`]
}

Table "public"."order_draft_item" {
  "id" int [pk, not null, increment]
  "order_id" int [not null, ref: > "public"."order"."id"]
  "item_id" int [not null, ref: > "public"."menu_item"."id"]
  "selection" jsonb [not null]
  "snapshot" jsonb [not null]
  "voided_at" timestamptz
  "voided_reason" text

  Indexes {
    (order_id, id) [name: "order_draft_item_order_id"]
  }
}

Table "public"."remote_order" {
  "id" int [pk, not null, ref: - "public"."order"."id"]
  "contact_phone" varchar(20) [not null]
  "estimated_minutes" int
  "delivery_notes" text
  "delivery_cep" varchar(8) [not null]
  "delivery_street" varchar(255) [not null]
  "delivery_number" varchar(20) [not null]
  "delivery_apt" varchar(50)
  "delivery_complement" varchar(255)
  "delivery_city" varchar(255)
  "delivery_state" varchar(2)
}

Table "public"."item_ingredient" {
  "id" int [pk, not null, increment]
  "item_id" int [not null, ref: > "public"."menu_item"."id"]
  "ingredient_id" int [not null, ref: > "public"."ingredient"."id"]
  "quantity" numeric(10,3)
  "measure" ingredient_unit_enum
  "is_removable" boolean [not null, default: false]

  Indexes {
    (item_id, ingredient_id) [unique, name: "idx_item_ingredient_item_id_ingredient_id"]
  }
}

Table "public"."physical_restaurant" {
  "id" int [pk, not null, increment]
  "restaurant_id" int [not null, ref: > "public"."restaurant"."id"]
  "address_id" int [not null, ref: > "public"."Address"."id"]
  "name" varchar(255) [not null]
  "cnpj" varchar(14) [not null]
  "owner_cnpj" varchar(14) [not null]
  "cnpj_verified" boolean [not null, default: false]
  "delivery_fee_cents" bigint [not null, default: 0]
  "operating_hours" jsonb [not null, default: ` '[]'::jsonb `, note: 'array of {weekday, opens_at, closes_at, is_closed}']
  "is_active" boolean [not null, default: true]
  "archived_at" timestamptz
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
}

Table "public"."dining_table" {
  "id" int [pk, not null, increment]
  "physical_restaurant_id" int [not null, ref: > "public"."physical_restaurant"."id"]
  "number" int [not null]
  "seats" int
  "display_order" int [not null, default: 0]
  "is_active" boolean [not null, default: true]

  Indexes {
    (physical_restaurant_id, number) [unique, name: "idx_dining_table_physical_restaurant_id_number"]
  }
}

Table "public"."account" {
  "id" int [pk, not null, increment]
  "email" varchar(255) [unique]
  "email_verified" boolean [not null, default: false]
  "password" varchar(255)
  "phone" varchar(20) [unique]
  "phone_verified" boolean [not null, default: false]
  "name" varchar(500)
  "avatar_url" text
  "address_id" int [ref: > "public"."Address"."id"]
  "cpf" varchar(11) [unique, note: 'set when CPF is entered at register OR claimed; UNIQUE prevents double-claim']
  "cpf_claimed_at" timestamptz
  "is_sysadmin" boolean [not null, default: false]
  "is_administrator" boolean [not null, default: false, note: 'Global authority across all organizations and branches']
  "two_factor_enabled" boolean [not null, default: false]
  "last_password_change" timestamptz
  "token_version" int [not null, default: 0]
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]

  Indexes {
    cpf [unique, name: "idx_account_cpf"]
    email [unique, name: "idx_account_email"]
    phone [unique, name: "idx_account_phone"]
  }

  Note: 'Shadow account: email = password = phone = NULL, only cpf set. Created by the register flow when a cashier enters an unknown CPF to accrue coins. \"Graduates\" to a real account when the customer signs up with that CPF: UPDATE account SET email=..., password=..., phone=... WHERE cpf=... UNIQUE(cpf) makes this safe under concurrent signup. At least one auth method (email or phone) is required for LOGIN, but shadow accounts are exempt until graduation — app-enforced. If email is set, password must also be set — app-enforced.'
}

Table "public"."employee" {
  "id" int [pk, not null, increment]
  "physical_restaurant_id" int [not null, ref: > "public"."physical_restaurant"."id"]
  "account_id" int [not null, ref: > "public"."account"."id"]
  "name" varchar(500) [not null, note: 'snapshot at hire time']
  "cpf" varchar(11) [note: 'snapshot at hire time']
  "position" employee_position_enum [not null]
  "is_active" boolean [not null, default: true]
  "hired_at" date
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]

  Indexes {
    physical_restaurant_id [name: "idx_employee_physical_restaurant_id"]
    (account_id, physical_restaurant_id) [unique, name: "idx_employee_account_branch"]
  }

  Note: 'One employee record per account per branch. An account can work in multiple branches.'
}

Table "public"."branch_manager" {
  "branch_id" int [not null, ref: > "public"."physical_restaurant"."id"]
  "account_id" int [not null, ref: > "public"."account"."id"]

  Indexes {
    (branch_id, account_id) [pk]
  }
}

Table "public"."loyalty_wallet" {
  "id" int [pk, not null, increment]
  "account_id" int [not null, ref: > "public"."account"."id"]
  "restaurant_id" int [not null, ref: > "public"."restaurant"."id"]
  "coins_amount" bigint [not null, default: 0]
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]

  Indexes {
    (account_id, restaurant_id) [unique, name: "idx_loyalty_wallet_account_restaurant"]
  }

  Note: 'One wallet per (account, restaurant). For shadow accounts, the wallet is created on first CPF entry at the register. When the account \"graduates\" (real signup with that CPF), the wallet is already there and immediately visible. coins_amount is a cache; wallet_transaction is the ledger.'
}

Table "public"."wallet_transaction" {
  "id" bigserial [pk, not null, increment]
  "loyalty_wallet_id" int [not null, ref: > "public"."loyalty_wallet"."id"]
  "points_delta" bigint [not null, note: 'positive = earned, negative = redeemed/expired']
  "balance_after" bigint [not null]
  "reason" varchar(100) [not null, note: 'earned | redeemed | admin_adjustment | expired | reversed']
  "order_id" int [ref: > "public"."order"."id"]
  "created_at" timestamptz [not null, default: `now()`]

  Indexes {
    order_id [name: "idx_wallet_transaction_order_id"]
    (loyalty_wallet_id, created_at) [name: "idx_wallet_transaction_wallet_id_created_at"]
  }

  Note: 'Append-only. Never UPDATE or DELETE. Idempotency via Redis: idempotency:wallet:{loyalty_wallet_id}:{key} → wallet_transaction_id (TTL 24h)'
}

Table "public"."account_restaurant" {
  "id" bigserial [pk, not null, increment]
  "account_id" int [not null, ref: > "public"."account"."id"]
  "restaurant_id" int [not null, ref: > "public"."restaurant"."id"]
  "account_type" account_type_enum [not null]
  "created_at" timestamptz [not null, default: `now()`]

  Indexes {
    (restaurant_id, account_type) [name: "idx_account_restaurant_restaurant_id_account_type"]
    (account_id, restaurant_id) [unique, name: "idx_account_restaurant_account_id_restaurant_id"]
  }

  Note: 'OWNER — organization authority. ANALYST — read-only analytics across the organization. Managers are assigned in branch_manager.'
}

Table "public"."receipt" {
  "id" int [pk, not null, increment]
  "order_id" int [unique, not null, ref: > "public"."order"."id"]
  "receipt_code" varchar(100) [unique, not null]
  "receipt" jsonb [not null]
  "issued_at" timestamptz [not null, default: `now()`]
}

Table "public"."item_review" {
  "id" bigserial [pk, not null, increment]
  "item_id" int [not null, ref: > "public"."menu_item"."id"]
  "order_item_id" int [unique, not null, ref: > "public"."order_item"."id"]
  "account_id" int [ref: > "public"."account"."id"]
  "rating" smallint [not null, note: '1-3']
  "comment" text
  "created_at" timestamptz [not null, default: `now()`]

  Indexes {
    (item_id, created_at) [name: "idx_item_review_item_id_created_at"]
  }

  Note: 'One per delivered, independently purchased line with reviews enabled. Comments require an account.'
}

Table "public"."restaurant_review" {
  "id" bigserial [pk, not null, increment]
  "restaurant_id" int [not null, ref: > "public"."restaurant"."id"]
  "account_id" int [ref: > "public"."account"."id"]
  "order_id" int [ref: > "public"."order"."id"]
  "rating" smallint [not null, note: '1-5']
  "comment" text
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]

  Indexes {
    (restaurant_id, created_at) [name: "idx_restaurant_review_restaurant_id_created_at"]
    (restaurant_id, account_id) [unique, name: "idx_restaurant_review_restaurant_id_account_id"]
  }

  Note: 'One per account per organization or one per guest order. Non-null order_id is unique. Comments require an account.'
}

Table "public"."item_review_totals" {
  "target_id" int [pk, not null, ref: > "public"."menu_item"."id"]
  "review_count" bigint [not null]
  "rating_sum" bigint [not null]
}

Table "public"."restaurant_review_totals" {
  "target_id" int [pk, not null, ref: > "public"."restaurant"."id"]
  "review_count" bigint [not null]
  "rating_sum" bigint [not null]
}

Table "public"."restaurant_phone" {
  "id" int [pk, not null, increment]
  "physical_restaurant_id" int [not null, ref: > "public"."physical_restaurant"."id"]
  "phone" varchar(20) [not null]
  "phone_type" restaurant_phone_type_enum [not null, default: 'mobile']
}

Table "public"."pix_charge" {
  "id" int [pk, not null, increment]
  "transaction_id" int [unique, not null, ref: > "public"."transaction"."id"]
  "copy_paste_code" text [not null]
  "qr_code_base64" text [not null]
  "expires_at" timestamptz [not null]
  "paid_at" timestamptz
  "created_at" timestamptz [not null, default: `now()`]
}

Table "public"."menu_session" {
  "id" bigint [pk, not null, increment]
  "restaurant_id" int [not null, ref: > "public"."restaurant"."id"]
  "physical_restaurant_id" int [not null, ref: > "public"."physical_restaurant"."id"]
  "dining_table_id" int [ref: > "public"."dining_table"."id"]
  "account_id" int [ref: > "public"."account"."id"]
  "visitor_fingerprint" varchar(128) [note: 'anonymous device/session hash for dedup']
  "channel" ux_channel_enum [not null]
  "device_type" device_type_enum [not null]
  "total_duration_ms" int [note: 'dwell time on the menu']
  "max_scroll_depth_pct" smallint [note: '0..100']
  "converted_order_id" int [ref: > "public"."order"."id"]
  "started_at" timestamptz [not null, default: `now()`]
  "last_activity_at" timestamptz [not null, default: `now()`]

  Indexes {
    (physical_restaurant_id, started_at) [name: "idx_menu_session_branch_started_at"]
    converted_order_id [name: "idx_menu_session_converted_order_id"]
    visitor_fingerprint [name: "idx_menu_session_visitor_fingerprint"]
  }

  Note: 'Session conversion rate = COUNT(converted_order_id) / COUNT(*). Partition candidate by started_at (monthly).'
}

Table "public"."refund" {
  "id" int [pk, not null, increment]
  "transaction_id" int [not null, ref: > "public"."transaction"."id"]
  "amount_cents" bigint [not null]
  "reason" text
  "idempotency_key" varchar(128)
  "created_by_account_id" int [ref: > "public"."account"."id"]
  "created_at" timestamptz [not null, default: `now()`]

  Indexes {
    transaction_id [name: "idx_refund_transaction_id"]
  }

  Note: 'Non-null idempotency_key is unique per transaction.'
}

Table "public"."ux_event" {
  "id" bigserial [pk, not null, increment]
  "session_id" bigint [not null, ref: > "public"."menu_session"."id"]
  "restaurant_id" int [not null, ref: > "public"."restaurant"."id"]
  "physical_restaurant_id" int [not null, ref: > "public"."physical_restaurant"."id"]
  "event_type" ux_event_type_enum [not null]
  "category_id" int [ref: > "public"."category"."id"]
  "item_id" int [ref: > "public"."menu_item"."id"]
  "duration_ms" int
  "quantity" int
  "cart_total_cents" bigint
  "metadata" jsonb
  "created_at" timestamptz [not null, default: `now()`]

  Indexes {
    (physical_restaurant_id, created_at) [name: "idx_ux_event_branch_created_at"]
    (item_id, event_type, created_at) [name: "idx_ux_event_item_event_created_at"]
    session_id [name: "idx_ux_event_session_id"]
    (event_type, created_at) [name: "idx_ux_event_type_created_at"]
  }

  Note: 'High-volume. Partition candidate by created_at (monthly).'
}

Table "public"."menu_item_price_history" {
  "id" bigserial [pk, not null, increment]
  "restaurant_id" int [not null, ref: > "public"."restaurant"."id"]
  "physical_restaurant_id" int [note: 'null for org-wide price change', ref: > "public"."physical_restaurant"."id"]
  "item_id" int [not null, ref: > "public"."menu_item"."id"]
  "changed_by_account_id" int [ref: > "public"."account"."id"]
  "old_price_cents" bigint [not null]
  "new_price_cents" bigint [not null]
  "reason" price_change_reason_enum [not null]
  "created_at" timestamptz [not null, default: `now()`]

  Indexes {
    (item_id, created_at) [name: "idx_price_history_item_id_created_at"]
    (reason, created_at) [name: "idx_price_history_reason_created_at"]
    (restaurant_id, created_at) [name: "idx_price_history_restaurant_id_created_at"]
  }

  Note: 'Append-only audit of base_price_cents changes.'
}

Table "public"."audit_entry" {
  "id" bigserial [pk, not null, increment]
  "actor_account_id" int [ref: > "public"."account"."id"]
  "actor_role" varchar(20)
  "restaurant_id" int [ref: > "public"."restaurant"."id"]
  "branch_id" int [ref: > "public"."physical_restaurant"."id"]
  "action" varchar(100) [not null]
  "entity_type" varchar(50) [not null]
  "entity_id" varchar(100) [not null]
  "metadata" jsonb
  "created_at" timestamptz [not null, default: `now()`]

  Indexes {
    (action, created_at) [name: "idx_audit_entry_action_created_at"]
    (actor_account_id, created_at) [name: "idx_audit_entry_actor_account_id_created_at"]
    (entity_type, entity_id, created_at) [name: "idx_audit_entry_entity_type_entity_id_created_at"]
    (restaurant_id, created_at) [name: "idx_audit_entry_restaurant_id_created_at"]
  }

  Note: 'Append-only. For forensics and customer-tendency analytics.'
}
